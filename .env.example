# Watcher — variables de entorno
# Copiar a `.env` en la raíz del repo. No commitear secretos.

# --- Runtime ---
ENVIRONMENT=development
HARDWARE_PROFILE=local

# --- Base de datos (dev local usa SQLite vía docker-compose.override.yml) ---
# DATABASE_URL=sqlite+aiosqlite:///sqlite.db
# SYNC_DATABASE_URL=sqlite:///sqlite.db

# --- Neo4j ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=watcher_neo4j_2026
# Heap 8 GB: solo via overlay (`make compose-local`). No setear NEO4J_HEAP_* aquí:
# docker compose interpola `.env` y rompería el default GCE (512m/1G).

# --- Pipeline (vacío = max(1, nproc-2)) ---
# PIPELINE_WORKERS=
PIPELINE_CPU_RESERVE=2
# Concurrent LLM calls (1 = seguro para RTX 5070 Ti 12 GB + 14B Q5)
LLM_MAX_CONCURRENT=1
# S2 judiciales llega a 500+ chunks; cap + chunks más grandes.
PIPELINE_CHUNK_SIZE=3000
PIPELINE_MAX_INDEX_CHUNKS=80
ANALYSIS_MAX_FRAGMENTS=8

# --- Inteligencia ---
# auto | local | google | free
# local = Ollama; google = Gemini; auto en hardware local usa Ollama si OLLAMA_BASE_URL está set
INTELLIGENCE_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
# 4096 KV-cache cabe en 12 GB con 14B Q4. 8192 suele ir a RAM y se pone lento.
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_S=600

# Gemini (fallback / cloud)
# GOOGLE_API_KEY=
LLM_PROVIDER=google

# --- Embeddings / rerank (perfil local prioriza modelos en disco/GPU) ---
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANK_STRATEGY=cross-encoder
LOCAL_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- App ---
# ALLOWED_ORIGINS=*
# MAX_UPLOAD_SIZE_MB=50
# BOLETINES_DIR=../boletines/
